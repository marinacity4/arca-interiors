---
const { title = "Arca Interiors", description = "Arca Interiors — an interior design studio in the San Francisco Bay Area. We shape spaces that could only be yours: homes, offices, and places that welcome others." } = Astro.props;
import "../styles/global.css";
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Text:ital,wght@0,400;0,700;1,400&family=Syne:wght@400;500;600;700;800&family=Archivo:wght@300;400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="cursor" id="cursor"></div>
  <slot />

  <script>
    // custom cursor
    const cursor = document.getElementById('cursor');
    let moved = false;
    document.addEventListener('mousemove', (e) => {
      if (!moved) { cursor.style.opacity = '1'; moved = true; }
      cursor.style.left = e.clientX + 'px';
      cursor.style.top = e.clientY + 'px';
    });
    const grow = () => cursor.classList.add('grow');
    const shrink = () => cursor.classList.remove('grow');
    document.querySelectorAll('a, button, input, textarea, select, [data-link]').forEach((el) => {
      el.addEventListener('mouseenter', grow);
      el.addEventListener('mouseleave', shrink);
    });

    // breathing reveal
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) e.target.classList.add('visible'); });
    }, { threshold: 0.1 });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
  </script>
</body>
</html>
