---
---
<section class="contact" id="contact">
  <div class="contact-left">
    <div class="contact-tag">Let's Work Together</div>
    <h2 class="contact-h2">Tell us<br />how you <em>live.</em><br />We'll design<br />around that.</h2>
    <p class="contact-sub">
      Every project starts with a conversation — not a brief.
      We want to understand your life before we touch your space.
    </p>
    <div class="contact-info">
      <div class="contact-info-item">
        <span class="contact-info-label">Studio</span>Menlo Park, California
      </div>
      <div class="contact-info-item">
        <span class="contact-info-label">Email</span>hello@arcainteriors.com
      </div>
      <div class="contact-info-item">
        <span class="contact-info-label">Phone</span>+1 (650) 000-0000
      </div>
    </div>
  </div>
  <div class="contact-form">
    <div class="form-title">Begin a conversation</div>
    <div class="form-grid">
      <div class="form-row">
        <label class="form-label">First Name</label>
        <input type="text" class="form-input" placeholder="Alexandra" />
      </div>
      <div class="form-row">
        <label class="form-label">Last Name</label>
        <input type="text" class="form-input" placeholder="Chen" />
      </div>
    </div>
    <div class="form-row">
      <label class="form-label">Email</label>
      <input type="email" class="form-input" placeholder="you@email.com" />
    </div>
    <div class="form-row">
      <label class="form-label">Type of Project</label>
      <select class="form-select form-input">
        <option value="">Select a service</option>
        <option>Interior Design</option>
        <option>Furniture Design</option>
        <option>Project Management</option>
        <option>Procurement</option>
        <option>Curation</option>
        <option>Styling</option>
        <option>Full Service</option>
      </select>
    </div>
    <div class="form-row">
      <label class="form-label">Tell us about your space</label>
      <textarea class="form-textarea" placeholder="Where is it, what do you want to feel there, and when are you hoping to begin..."></textarea>
    </div>
    <button class="form-submit">Send</button>
  </div>
</section>
