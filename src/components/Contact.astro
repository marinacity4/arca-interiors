---
---
<section class="contact" id="contact">
  <div class="contact-left">
    <div class="contact-tag">Let's Work Together</div>
    <h2 class="contact-h2">Your project<br />starts with a<br /><em>conversation.</em></h2>
    <p class="contact-sub">Tell us about your space, your vision, and how you want to live in it. We'll take it from there.</p>
    <div class="contact-info">
      <div class="contact-info-item">
        <span class="contact-info-label">Studio</span>Menlo Park, California
      </div>
      <div class="contact-info-item">
        <span class="contact-info-label">Email</span>hello@arcainteriors.com
      </div>
      <div class="contact-info-item">
        <span class="contact-info-label">Phone</span>+1 (650) 000-0000
      </div>
    </div>
  </div>
  <div class="contact-form">
    <div class="form-title">Book a Free Consultation</div>
    <div class="form-grid">
      <div class="form-row">
        <label class="form-label">First Name</label>
        <input type="text" class="form-input" placeholder="Alexandra" />
      </div>
      <div class="form-row">
        <label class="form-label">Last Name</label>
        <input type="text" class="form-input" placeholder="Chen" />
      </div>
    </div>
    <div class="form-row">
      <label class="form-label">Email</label>
      <input type="email" class="form-input" placeholder="you@email.com" />
    </div>
    <div class="form-row">
      <label class="form-label">Project Type</label>
      <select class="form-select form-input">
        <option value="">Select a service</option>
        <option>Residential Design</option>
        <option>Commercial / Hospitality</option>
        <option>Wellness Interiors</option>
        <option>Space Planning</option>
        <option>Concept & Styling</option>
        <option>Other</option>
      </select>
    </div>
    <div class="form-row">
      <label class="form-label">Tell us about your project</label>
      <textarea class="form-textarea" placeholder="Location, scope, timeline, and how you want to feel in the space..."></textarea>
    </div>
    <button class="form-submit">Send Inquiry</button>
  </div>
</section>
