---
const { active = "" } = Astro.props;
const links = [
  { name: "Portfolio", href: "/portfolio" },
  { name: "Studio", href: "/studio" },
  { name: "Contact", href: "/contact" },
];
---
<nav class="nav">
  <a href="/" class="logo">ARCA INTERIORS</a>
  <ul class="nav-links">
    {links.map((l) => (
      <li><a href={l.href} class={active === l.name ? "active" : ""}>{l.name}</a></li>
    ))}
  </ul>
</nav>
