---
<footer class="dark-foot">
  <a href="/" class="df-logo">ARCA INTERIORS</a>
  <div class="df-right">
    <a href="mailto:hello@arcainteriors.studio" class="df-link">hello@arcainteriors.studio</a>
    <a href="https://instagram.com/arca.interiors" target="_blank" rel="noopener" class="df-link">Instagram</a>
    <span class="df-copy">© 2026</span>
  </div>
</footer>

<style>
  .dark-foot {
    margin-top: auto;
    background: var(--ink);
    color: var(--paper);
    padding: 1.5rem var(--pad-x);
    display: flex; align-items: center; justify-content: space-between;
  }
  .df-logo {
    font-family: 'Syne', sans-serif; font-weight: 700;
    font-size: 0.85rem; letter-spacing: 0.18em;
    color: var(--paper); text-decoration: none;
  }
  .df-right { display: flex; align-items: center; gap: 2rem; }
  .df-link {
    font-size: 0.72rem; letter-spacing: 0.08em; text-decoration: none;
    color: rgba(250,248,243,0.85); position: relative; padding-bottom: 3px;
  }
  .df-link::after {
    content: ''; position: absolute; left: 0; bottom: 0;
    width: 0; height: 1px; background: var(--blue);
    transition: width 0.4s cubic-bezier(0.4,0,0.2,1);
  }
  .df-link:hover::after { width: 100%; }
  .df-copy { font-size: 0.62rem; letter-spacing: 0.12em; color: rgba(250,248,243,0.4); }

  @media (max-width: 640px) {
    .dark-foot { flex-direction: column; gap: 1.2rem; align-items: flex-start; }
    .df-right { gap: 1.3rem; flex-wrap: wrap; }
  }
</style>
