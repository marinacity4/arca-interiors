---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

---
<Layout title="Arca Interiors — Every space is its own small world">
  <Nav />

  <section class="hero">
    <div class="hero-img" data-link></div>
  </section>

  <section class="intro">
    <div class="eyebrow">Interior Design Studio — San Francisco Bay Area</div>
    <h1 class="intro-headline">Every space is its own<br>small world. We help<br>you shape <em>yours.</em></h1>
    <p class="intro-desc">Whether it's a home, an office, or a place that welcomes others, we start the same way — by understanding your world, then shaping a space that could only be yours.</p>
  </section>

  <Footer />
</Layout>

<style>
  .hero { padding: 1rem var(--pad-x) 0; }
  .hero-img {
    width: 100%; aspect-ratio: 21/9;
    max-height: 58vh;
    background-image: url('/images/hero.jpg');
    background-size: cover; background-position: center;
    background-color: var(--sand);
  }

  .intro { padding: 4.5rem var(--pad-x) 6rem; max-width: 800px; }
  .intro .eyebrow { margin-bottom: 2.2rem; }
  .intro-headline {
    font-family: 'Libre Caslon Text', serif;
    font-size: clamp(2.4rem, 5vw, 4rem);
    font-weight: 400; line-height: 1.1; color: var(--ink);
    margin-bottom: 2rem; letter-spacing: -0.01em;
  }
  .intro-headline em { font-style: italic; }
  .intro-desc { font-size: 1.05rem; line-height: 1.85; font-weight: 300; color: var(--ink-soft); max-width: 520px; }

  @media (max-width: 640px) {
    .hero-img { max-height: 40vh; }
  }

</style>
