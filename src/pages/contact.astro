---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---
<Layout title="Contact — Arca Interiors">
  <Nav active="Contact" />

  <section class="contact">
    <div class="contact-left">
      <div class="eyebrow">Get in Touch</div>
      <h1 class="headline">Tell us about<br>your <em>world.</em></h1>
      <p class="lede">Where you are, how you want to feel in it, what you're hoping to change. That's where we begin.</p>
      <div class="contact-info">
        <div class="ci-row"><span class="ci-label">Studio</span><span>San Francisco Bay Area</span></div>
        <div class="ci-row"><span class="ci-label">Email</span><span class="ci-mail">hello@arcainteriors.studio</span></div>
        <div class="ci-row"><span class="ci-label">Instagram</span><a href="https://instagram.com/arca.interiors" target="_blank" rel="noopener" class="ci-ig">@arca.interiors</a></div>
      </div>
    </div>

    <div class="contact-form">
      <form name="contact" method="POST" data-netlify="true">
        <input type="hidden" name="form-name" value="contact" />
        <div class="fld">
          <label>Name</label>
          <input type="text" name="name" placeholder="Your name" />
        </div>
        <div class="fld">
          <label>Email</label>
          <input type="email" name="email" placeholder="you@email.com" />
        </div>
        <div class="fld">
          <label>The space</label>
          <input type="text" name="space" placeholder="A home, an office, a place that welcomes others…" />
        </div>
        <div class="fld">
          <label>Tell us a bit more</label>
          <textarea name="message" rows="4" placeholder="The space, your timeline, anything you'd like us to know."></textarea>
        </div>
        <button type="submit" class="submit">Send</button>
      </form>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .contact { display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; padding: 4rem var(--pad-x) 6rem; align-items: start; }
  .contact-left .eyebrow { margin-bottom: 2.2rem; }
  .contact-left .headline { margin-bottom: 1.8rem; }
  .contact-left .lede { margin-bottom: 3rem; }

  .contact-info { display: flex; flex-direction: column; gap: 1rem; }
  .ci-row { display: flex; gap: 1.5rem; align-items: baseline; }
  .ci-label { font-size: 0.6rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--stone); min-width: 60px; }
  .ci-row span:not(.ci-label) { font-size: 0.92rem; color: var(--ink-soft); }
  .ci-mail { color: var(--blue) !important; }
  .ci-ig { color: var(--blue); text-decoration: none; font-size: 0.92rem; position: relative; padding-bottom: 2px; }
  .ci-ig::after { content: ""; position: absolute; left: 0; bottom: 0; width: 0; height: 1px; background: var(--blue); transition: width 0.4s; }
  .ci-ig:hover::after { width: 100%; }

  .contact-form { padding-top: 1rem; }
  .fld { margin-bottom: 2rem; }
  .fld label {
    display: block; font-size: 0.6rem; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--stone); margin-bottom: 0.6rem;
  }
  .fld input, .fld textarea {
    width: 100%; font-family: 'Archivo', sans-serif; font-size: 0.95rem; font-weight: 300;
    color: var(--ink); background: transparent; border: none;
    border-bottom: 1px solid var(--sand); padding: 0.7rem 0; outline: none;
    transition: border-color 0.3s; resize: none;
  }
  .fld input::placeholder, .fld textarea::placeholder { color: var(--stone); opacity: 0.6; }
  .fld input:focus, .fld textarea:focus { border-color: var(--blue); }

  .submit {
    font-family: 'Archivo', sans-serif; font-size: 0.68rem; letter-spacing: 0.22em; text-transform: uppercase;
    background: transparent; color: var(--ink); border: 0.5px solid var(--ink);
    padding: 1rem 3rem; margin-top: 1rem; transition: background 0.3s, color 0.3s;
  }
  .submit:hover { background: var(--ink); color: var(--paper); }

  @media (max-width: 760px) {
    .contact { grid-template-columns: 1fr; gap: 3rem; }
  }
</style>
