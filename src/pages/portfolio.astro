---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const projects = [
  {
    idx: "01",
    name: "Restaurant in Pittsburgh",
    cat: "Hospitality",
    loc: "Pittsburgh, PA",
    status: "",
    img: "/images/project-1.jpg",
    href: "/projects/restaurant-in-pittsburgh",
  },
  {
    idx: "02",
    name: "Apartment in San Francisco",
    cat: "Residential",
    loc: "San Francisco, CA",
    status: "In progress",
    img: "/images/sf-apartment-teaser.jpg",
    href: "",
  },
  {
    idx: "03",
    name: "House in Palo Alto",
    cat: "Residential",
    loc: "Palo Alto, CA",
    status: "In progress",
    img: "/images/palo-alto-teaser.jpg",
    href: "",
  },
];
---
<Layout title="Portfolio — Arca Interiors">
  <Nav active="Portfolio" />

  <section class="port-head">
    <div class="eyebrow">Selected Work</div>
  </section>

  <section class="port-list">
    {projects.map((p) => (
      p.href ? (
        <a class="proj reveal" href={p.href} data-link>
          <div class="proj-img" style={`background-image:url('${p.img}')`}></div>
          <div class="proj-meta">
            <span class="index">{p.idx}</span>
            <h2 class="proj-name">{p.name}</h2>
            <span class="proj-cat">{p.cat} · {p.loc}</span>
          </div>
        </a>
      ) : (
        <article class="proj reveal">
          <div class="proj-img teaser" style={`background-image:url('${p.img}')`}>
            <span class="teaser-tag">{p.status}</span>
          </div>
          <div class="proj-meta">
            <span class="index">{p.idx}</span>
            <h2 class="proj-name">{p.name}</h2>
            <span class="proj-cat">{p.cat} · {p.loc} — <em>{p.status}</em></span>
          </div>
        </article>
      )
    ))}
  </section>

  <Footer />
</Layout>

<style>
  .port-head { padding: 4rem var(--pad-x) 5rem; max-width: 900px; }
  .port-head .eyebrow { margin-bottom: 2.2rem; }

  .port-list { padding: 0 var(--pad-x) 6rem; display: flex; flex-direction: column; gap: 5rem; }
  .proj { display: flex; flex-direction: column; gap: 1.5rem; text-decoration: none; }
  .proj-img {
    width: 100%; aspect-ratio: 3/2;
    background-size: cover; background-position: center;
    background-color: var(--sand);
    transition: opacity 0.4s ease;
    position: relative;
  }
  a.proj:hover .proj-img { opacity: 0.92; }
  .proj:first-child .proj-img { aspect-ratio: 21/9; }

  /* teaser overlay for in-progress work */
  .proj-img.teaser { display: flex; align-items: center; justify-content: center; }
  .teaser-tag {
    font-size: 0.6rem; letter-spacing: 0.26em; text-transform: uppercase;
    color: var(--ink-soft); background: rgba(250,248,243,0.72);
    padding: 0.85rem 1.8rem; backdrop-filter: blur(4px);
  }

  .proj-meta {
    display: grid; grid-template-columns: 50px 1fr auto;
    gap: 2rem; align-items: baseline;
  }
  .proj-name {
    font-family: 'Libre Caslon Text', serif;
    font-size: clamp(1.5rem, 2.8vw, 2.2rem); font-weight: 400; color: var(--ink);
    letter-spacing: -0.005em;
  }
  .proj-cat { font-size: 0.62rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--stone); }
  .proj-cat em { font-style: normal; color: var(--blue); }

  @media (max-width: 640px) {
    .proj-meta { grid-template-columns: 36px 1fr; }
    .proj-cat { grid-column: 2; margin-top: 0.4rem; }
  }
</style>
